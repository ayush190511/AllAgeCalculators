---
import { OfflineBanner } from './OfflineBanner';
const currentPath = Astro.url.pathname;
---

<header class="w-full bg-[var(--canvas-card)]/90 backdrop-blur-md border-b border-[var(--hairline)] sticky top-0 z-50 transition-colors">
  <OfflineBanner client:load />
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="h-16 flex items-center justify-between">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group shrink-0">
        <img 
          src="/favicon.png" 
          alt="AllAgeCalculators Logo" 
          class="h-8 sm:h-9 w-auto object-contain rounded-lg shadow-2xs transition group-hover:scale-105" 
        />
        <div class="hidden sm:flex flex-col">
          <span class="text-sm font-bold tracking-tight text-[var(--ink-primary)] leading-none">
            AllAgeCalculators
          </span>
          <span class="text-[10px] font-mono text-[var(--ink-mute)] mt-0.5">allagecalculators.com</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 text-xs font-medium text-[var(--ink-body)]">
        <a 
          href="/" 
          class={`px-2.5 py-1.5 rounded-lg transition ${currentPath === '/' ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]' : 'hover:text-[var(--ink-primary)]'}`}
        >
          Home
        </a>
        <a 
          href="/upsc-age-calculator" 
          class={`px-2.5 py-1.5 rounded-lg transition ${currentPath === '/upsc-age-calculator' || currentPath === '/upsc-age-calculator/' ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]' : 'hover:text-[var(--ink-primary)]'}`}
        >
          UPSC Engine
        </a>
        <a 
          href="/retirement-age-calculator" 
          class={`px-2.5 py-1.5 rounded-lg transition ${currentPath === '/retirement-age-calculator' || currentPath === '/retirement-age-calculator/' ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]' : 'hover:text-[var(--ink-primary)]'}`}
        >
          Retirement
        </a>
        <a 
          href="/dog-age-calculator" 
          class={`px-2.5 py-1.5 rounded-lg transition ${currentPath === '/dog-age-calculator' || currentPath === '/dog-age-calculator/' ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]' : 'hover:text-[var(--ink-primary)]'}`}
        >
          Dog Age 🐶
        </a>
        <a 
          href="/baby-age-calculator" 
          class={`px-2.5 py-1.5 rounded-lg transition ${currentPath === '/baby-age-calculator' || currentPath === '/baby-age-calculator/' ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]' : 'hover:text-[var(--ink-primary)]'}`}
        >
          Baby Age 👶
        </a>
        <a 
          href="/date-difference-calculator" 
          class={`px-2.5 py-1.5 rounded-lg transition ${currentPath === '/date-difference-calculator' || currentPath === '/date-difference-calculator/' ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]' : 'hover:text-[var(--ink-primary)]'}`}
        >
          Date Diff
        </a>
                <!-- Vertical Divider Separator between Calculators & Info Pages -->
        <div class="h-4 w-px bg-[var(--hairline-strong)] mx-1.5 shrink-0 opacity-60"></div>

        <!-- Clean "More / Pages & Legal" Dropdown Menu -->
        <div class="relative group">
          <button 
            type="button"
            class={`px-2.5 py-1.5 rounded-lg transition flex items-center gap-1 cursor-pointer select-none ${
              currentPath === '/about' || currentPath === '/about/' ||
              currentPath === '/contact' || currentPath === '/contact/' ||
              currentPath === '/privacy-policy' || currentPath === '/privacy-policy/' ||
              currentPath === '/terms-and-conditions' || currentPath === '/terms-and-conditions/'
                ? 'bg-[var(--canvas-inset)] text-[var(--ink-primary)] font-semibold border border-[var(--hairline)]'
                : 'hover:text-[var(--ink-primary)] text-[var(--ink-mute)]'
            }`}
          >
            <span>More</span>
            <svg class="w-3 h-3 text-[var(--ink-mute)] group-hover:text-[var(--ink-primary)] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown Card -->
          <div class="absolute right-0 top-full mt-1.5 w-48 py-1.5 bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            <a 
              href="/about" 
              class={`flex items-center gap-2.5 px-3 py-2 text-xs transition hover:bg-[var(--canvas-inset)] ${currentPath === '/about' || currentPath === '/about/' ? 'font-bold text-[var(--ink-primary)]' : 'text-[var(--ink-body)]'}`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#0070f3]"></span>
              About Us
            </a>
            <a 
              href="/contact" 
              class={`flex items-center gap-2.5 px-3 py-2 text-xs transition hover:bg-[var(--canvas-inset)] ${currentPath === '/contact' || currentPath === '/contact/' ? 'font-bold text-[var(--ink-primary)]' : 'text-[var(--ink-body)]'}`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#10b981]"></span>
              Contact Us
            </a>
            <div class="my-1 border-t border-[var(--hairline)]"></div>
            <a 
              href="/privacy-policy" 
              class={`flex items-center gap-2.5 px-3 py-2 text-xs transition hover:bg-[var(--canvas-inset)] ${currentPath === '/privacy-policy' || currentPath === '/privacy-policy/' ? 'font-bold text-[var(--ink-primary)]' : 'text-[var(--ink-body)]'}`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#7928ca]"></span>
              Privacy Policy
            </a>
            <a 
              href="/terms-and-conditions" 
              class={`flex items-center gap-2.5 px-3 py-2 text-xs transition hover:bg-[var(--canvas-inset)] ${currentPath === '/terms-and-conditions' || currentPath === '/terms-and-conditions/' ? 'font-bold text-[var(--ink-primary)]' : 'text-[var(--ink-body)]'}`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-[#f5a623]"></span>
              Terms & Conditions
            </a>
          </div>
        </div>
      </nav>

      <!-- Right Header Controls -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="p-2 rounded-lg bg-[var(--canvas-inset)] border border-[var(--hairline)] text-[var(--ink-primary)] hover:border-[var(--ink-primary)] transition flex items-center justify-center cursor-pointer select-none"
        >
          <!-- Sun Icon (visible in dark mode) -->
          <svg id="theme-toggle-sun-icon" class="w-4 h-4 text-[#f5a623]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <!-- Moon Icon (visible in light mode) -->
          <svg id="theme-toggle-moon-icon" class="w-4 h-4 text-[var(--ink-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>

        <!-- Mobile Menu Toggle Button with Smooth Hamburger-to-Cross Transformation -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          class="lg:hidden p-2.5 rounded-lg bg-[var(--canvas-inset)] border border-[var(--hairline)] text-[var(--ink-primary)] hover:border-[var(--ink-primary)] transition flex items-center justify-center cursor-pointer select-none"
        >
          <div id="hamburger-animated-icon" class="w-5 h-4 relative flex flex-col justify-between transition-transform duration-300">
            <span class="hamburger-bar w-full h-[2px] bg-current rounded-full transition-all duration-300 ease-in-out origin-center"></span>
            <span class="hamburger-bar w-full h-[2px] bg-current rounded-full transition-all duration-300 ease-in-out origin-center"></span>
            <span class="hamburger-bar w-full h-[2px] bg-current rounded-full transition-all duration-300 ease-in-out origin-center"></span>
          </div>
        </button>
      </div>
    </div>

    <!-- Touchscreen Horizontal Scroll Pill Bar (Tool Links Only) -->
    <div id="mobile-pill-container" class="lg:hidden flex items-center gap-1.5 overflow-x-auto pb-2.5 pt-0.5 no-scrollbar border-t border-[var(--hairline)]/50">
      <a 
        href="/" 
        class={`px-3 py-1 rounded-full whitespace-nowrap text-xs transition border ${currentPath === '/' ? 'mobile-active-pill bg-[var(--ink-primary)] text-[var(--canvas-card)] border-[var(--ink-primary)] font-semibold' : 'bg-[var(--canvas-inset)] text-[var(--ink-body)] border-[var(--hairline)]'}`}
      >
        Home
      </a>
      <a 
        href="/upsc-age-calculator" 
        class={`px-3 py-1 rounded-full whitespace-nowrap text-xs transition border ${currentPath === '/upsc-age-calculator' || currentPath === '/upsc-age-calculator/' ? 'mobile-active-pill bg-[var(--ink-primary)] text-[var(--canvas-card)] border-[var(--ink-primary)] font-semibold' : 'bg-[var(--canvas-inset)] text-[var(--ink-body)] border-[var(--hairline)]'}`}
      >
        UPSC Engine
      </a>
      <a 
        href="/retirement-age-calculator" 
        class={`px-3 py-1 rounded-full whitespace-nowrap text-xs transition border ${currentPath === '/retirement-age-calculator' || currentPath === '/retirement-age-calculator/' ? 'mobile-active-pill bg-[var(--ink-primary)] text-[var(--canvas-card)] border-[var(--ink-primary)] font-semibold' : 'bg-[var(--canvas-inset)] text-[var(--ink-body)] border-[var(--hairline)]'}`}
      >
        Retirement
      </a>
      <a 
        href="/dog-age-calculator" 
        class={`px-3 py-1 rounded-full whitespace-nowrap text-xs transition border ${currentPath === '/dog-age-calculator' || currentPath === '/dog-age-calculator/' ? 'mobile-active-pill bg-[var(--ink-primary)] text-[var(--canvas-card)] border-[var(--ink-primary)] font-semibold' : 'bg-[var(--canvas-inset)] text-[var(--ink-body)] border-[var(--hairline)]'}`}
      >
        Dog Age 🐶
      </a>
      <a 
        href="/baby-age-calculator" 
        class={`px-3 py-1 rounded-full whitespace-nowrap text-xs transition border ${currentPath === '/baby-age-calculator' || currentPath === '/baby-age-calculator/' ? 'mobile-active-pill bg-[var(--ink-primary)] text-[var(--canvas-card)] border-[var(--ink-primary)] font-semibold' : 'bg-[var(--canvas-inset)] text-[var(--ink-body)] border-[var(--hairline)]'}`}
      >
        Baby Age 👶
      </a>
      <a 
        href="/date-difference-calculator" 
        class={`px-3 py-1 rounded-full whitespace-nowrap text-xs transition border ${currentPath === '/date-difference-calculator' || currentPath === '/date-difference-calculator/' ? 'mobile-active-pill bg-[var(--ink-primary)] text-[var(--canvas-card)] border-[var(--hairline)]' : 'bg-[var(--canvas-inset)] text-[var(--ink-body)] border-[var(--hairline)]'}`}
      >
        Date Diff
      </a>
    </div>

    <!-- Mobile Hamburger Drawer Menu with Smooth Accordion Slide Down/Up Animation -->
    <div id="mobile-menu-drawer" class="mobile-drawer-accordion lg:hidden">
      <div class="overflow-hidden">
        <div class="py-3 border-t border-[var(--hairline)] space-y-1.5 text-xs">
          <div class="px-1 py-1 text-[11px] font-mono uppercase tracking-wider text-[var(--ink-mute)]">
            More Pages & Legal
          </div>
          <a 
            href="/about" 
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition ${currentPath === '/about' || currentPath === '/about/' ? 'bg-[var(--ink-primary)] text-[var(--canvas-card)] font-semibold' : 'text-[var(--ink-primary)] bg-[var(--canvas-inset)] hover:bg-[var(--hairline)]'}`}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#0070f3]"></span>
            About Us & Mission
          </a>
          <a 
            href="/contact" 
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition ${currentPath === '/contact' || currentPath === '/contact/' ? 'bg-[var(--ink-primary)] text-[var(--canvas-card)] font-semibold' : 'text-[var(--ink-primary)] bg-[var(--canvas-inset)] hover:bg-[var(--hairline)]'}`}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#10b981]"></span>
            Contact Us
          </a>
          <a 
            href="/privacy-policy" 
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition ${currentPath === '/privacy-policy' || currentPath === '/privacy-policy/' ? 'bg-[var(--ink-primary)] text-[var(--canvas-card)] font-semibold' : 'text-[var(--ink-primary)] bg-[var(--canvas-inset)] hover:bg-[var(--hairline)]'}`}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#7928ca]"></span>
            Privacy Policy
          </a>
          <a 
            href="/terms-and-conditions" 
            class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-medium transition ${currentPath === '/terms-and-conditions' || currentPath === '/terms-and-conditions/' ? 'bg-[var(--ink-primary)] text-[var(--canvas-card)] font-semibold' : 'text-[var(--ink-primary)] bg-[var(--canvas-inset)] hover:bg-[var(--hairline)]'}`}
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#f5a623]"></span>
            Terms & Conditions
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  window.__toggleTheme = function() {
    const htmlEl = document.documentElement;
    if (htmlEl.classList.contains('dark')) {
      htmlEl.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      htmlEl.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  };

  const btn = document.getElementById('theme-toggle');
  if (btn) {
    btn.addEventListener('click', window.__toggleTheme);
  }

  const mobileBtn = document.getElementById('mobile-menu-toggle');
  const mobileDrawer = document.getElementById('mobile-menu-drawer');
  const animatedIcon = document.getElementById('hamburger-animated-icon');

  function openMobileMenu() {
    if (!mobileDrawer) return;
    mobileDrawer.classList.add('is-open');
    mobileBtn?.setAttribute('aria-expanded', 'true');
    animatedIcon?.classList.add('is-active');
  }

  function closeMobileMenu() {
    if (!mobileDrawer) return;
    mobileDrawer.classList.remove('is-open');
    mobileBtn?.setAttribute('aria-expanded', 'false');
    animatedIcon?.classList.remove('is-active');
  }

  function toggleMobileMenu() {
    if (!mobileDrawer) return;
    if (mobileDrawer.classList.contains('is-open')) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  if (mobileBtn) {
    mobileBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleMobileMenu();
    });
  }

  // Close drawer when clicking outside
  document.addEventListener('click', function(e) {
    if (mobileDrawer && mobileDrawer.classList.contains('is-open')) {
      if (!mobileDrawer.contains(e.target) && !mobileBtn?.contains(e.target)) {
        closeMobileMenu();
      }
    }
  });

  // Close drawer on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && mobileDrawer && mobileDrawer.classList.contains('is-open')) {
      closeMobileMenu();
    }
  });

  // Close drawer when clicking on any link inside
  if (mobileDrawer) {
    const drawerLinks = mobileDrawer.querySelectorAll('a');
    drawerLinks.forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });
  }

  // Auto-scroll mobile pill nav container so active link is always centered and visible
  function centerActiveMobilePill() {
    const pillContainer = document.getElementById('mobile-pill-container');
    const activePill = document.querySelector('.mobile-active-pill');
    if (pillContainer && activePill) {
      const containerWidth = pillContainer.clientWidth;
      const pillOffset = activePill.offsetLeft;
      const pillWidth = activePill.clientWidth;
      pillContainer.scrollLeft = pillOffset - (containerWidth / 2) + (pillWidth / 2);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', centerActiveMobilePill);
  } else {
    centerActiveMobilePill();
  }
</script>
