const faqItems = faqMap[page] || homeFaqs;

const schemaJson = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answerHtml
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />

<section id="faq" class="mt-16 pt-16 border-t border-[var(--hairline)] space-y-12">
  
