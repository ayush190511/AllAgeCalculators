  <!-- Route-Specific Extra Blocks -->
  {page === 'upsc' && (
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-xl p-6 shadow-sm space-y-3">
        <h3 class="text-lg font-bold text-[var(--ink-primary)] tracking-tight">
          Category-wise Attempt Limits
        </h3>
        <ul class="text-xs text-[var(--ink-body)] space-y-2 list-disc list-inside font-mono-num">
          <li><strong>General / EWS:</strong> 6 Attempts up to 32 Years</li>
          <li><strong>OBC (Non-Creamy Layer):</strong> 9 Attempts up to 35 Years</li>
          <li><strong>SC / ST:</strong> Unlimited Attempts up to 37 Years</li>
          <li><strong>PwBD (GEN/EWS/OBC):</strong> 9 Attempts up to 42-45 Years</li>
          <li><strong>PwBD (SC/ST):</strong> Unlimited Attempts up to 47 Years</li>
        </ul>
      </div>

      <div class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-xl p-6 shadow-sm space-y-3">
        <h3 class="text-lg font-bold text-[var(--ink-primary)] tracking-tight">
          Ex-Servicemen & Special Relaxations
        </h3>
        <p class="text-xs text-[var(--ink-body)] leading-relaxed">
          Commissioned Officers including ECOs/SSCOs who have rendered at least 5 years military service receive up to 5 years age relaxation (maximum upper limit capped at 37 years for General). Defence personnel disabled in operations receive +3 years (GEN/OBC) or +8 years (SC/ST).
        </p>
      </div>
    </div>
  )}

  <!-- FAQ Accordion -->
  <div class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-xl p-8 shadow-sm space-y-6">
    <div class="border-b border-[var(--hairline)] pb-4">
      <h2 class="text-xl font-bold tracking-tight text-[var(--ink-primary)]">
        Frequently Asked Questions & Calculator Guidance
      </h2>
      <p class="text-xs text-[var(--ink-mute)] mt-1">
        Targeted answers to top search queries and user questions.
      </p>
    </div>

    <div class="space-y-4">
      {faqItems.map((item) => (
        <details class="group border border-[var(--hairline)] rounded-lg p-4 transition [&_summary::-webkit-details-marker]:hidden bg-[var(--canvas-inset)]">
          <summary class="flex items-center justify-between gap-2.5 font-semibold text-sm text-[var(--ink-primary)] cursor-pointer select-none">
            <span class="capitalize">{item.question}</span>
            <span class="text-[var(--ink-mute)] group-open:rotate-180 transition-transform shrink-0">▼</span>
          </summary>
          <div class="mt-3 text-xs text-[var(--ink-body)] leading-relaxed border-t border-[var(--hairline)] pt-3">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
