---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Privacy Policy Meta Tags -->
    <title>Privacy Policy — AllAgeCalculators</title>
    <meta name="title" content="Privacy Policy — AllAgeCalculators" />
    <meta 
      name="description" 
      content="Privacy Policy for AllAgeCalculators (allagecalculators.com). Learn how we prioritize user privacy through 100% client-side age processing with zero date-of-birth storage." 
    />
    <link rel="canonical" href="https://allagecalculators.com/privacy-policy" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://allagecalculators.com/privacy-policy" />
    <meta property="og:title" content="Privacy Policy — AllAgeCalculators" />
    <meta property="og:description" content="Discover our 100% client-side privacy standard. We do not store or transmit your date of birth data." />

    <!-- Theme Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-12 pb-20 space-y-10">
        <!-- Hero Header -->
        <div class="text-center space-y-4 max-w-2xl mx-auto">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[var(--canvas-card)] border border-[var(--hairline)] text-xs font-mono text-[var(--ink-body)] shadow-2xs">
            <span class="h-2 w-2 rounded-full bg-[#0070f3]"></span>
            Data Protection & Transparency
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink-primary)]">
            Privacy Policy
          </h1>

          <p class="text-sm text-[var(--ink-body)]">
            Last Updated: August 10, 2026
          </p>
        </div>

        <!-- Main Privacy Document -->
        <article class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-xl p-8 sm:p-10 shadow-sm space-y-8 text-xs sm:text-sm text-[var(--ink-body)] leading-relaxed">
          
          <section class="space-y-3">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              1. Commitment to Privacy (100% Client-Side Processing)
            </h2>
            <p>
              At <strong>AllAgeCalculators (allagecalculators.com)</strong>, accessible from https://allagecalculators.com, one of our main priorities is the privacy of our visitors. All age calculations, date-of-birth inputs, time intervals, and category selections are executed <strong>100% client-side in your web browser</strong> using JavaScript.
            </p>
            <p>
              Your Date of Birth (DOB) and personal inputs are <strong>never uploaded, saved, or logged on our servers</strong>.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              2. Information We Collect
            </h2>
            <p>
              We do not require account registration, email addresses, or personal identity verification to use any of our calculators.
            </p>
            <ul class="list-disc list-inside space-y-1.5 pl-2">
              <li><strong>Local Storage:</strong> We store your theme preference (Light or Dark mode) locally in your browser's <code>localStorage</code> so the site stays in your preferred theme.</li>
              <li><strong>Log Files:</strong> Standard web server log files record non-personal technical data (IP addresses, browser type, ISP, referring/exit pages, date/time stamp, and click count) for security monitoring and server performance optimization.</li>
            </ul>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              3. Cookies and Web Beacons
            </h2>
            <p>
              AllAgeCalculators does not use intrusive tracking cookies. Like any other website, basic technical cookies or session tokens may be utilized by standard web hosting services to ensure proper page delivery and security.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              4. Third-Party Links & Educational Resources
            </h2>
            <p>
              Our website may contain informational links to third-party government websites (e.g., upsc.gov.in). We have no control over and assume no responsibility for the content, privacy policies, or practices of any third-party sites.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              5. Children's Privacy Information
            </h2>
            <p>
              Another part of our priority is adding protection for children while using the internet. We encourage parents and guardians to observe, participate in, and/or monitor and guide their online activity. AllAgeCalculators does not knowingly collect any Personal Identifiable Information from children under the age of 13.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              6. Consent
            </h2>
            <p>
              By using our website, you hereby consent to our Privacy Policy and agree to its terms.
            </p>
          </section>

        </article>
      </main>
    </div>

    <Footer />
  </body>
</html>
