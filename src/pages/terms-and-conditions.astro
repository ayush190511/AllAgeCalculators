---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOSchema from '../components/SEOSchema.astro';
import '../styles/global.css';

const title = "Terms and Conditions — AllAgeCalculators";
const description = "Terms and Conditions for AllAgeCalculators (allagecalculators.com). Read our terms of service, calculation accuracy disclaimers, and user guidelines.";
const canonicalUrl = "https://allagecalculators.com/terms-and-conditions";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Terms and Conditions Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AllAgeCalculators (allagecalculators.com)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://allagecalculators.com/og-image.png" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://allagecalculators.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="terms" title={title} description={description} canonicalUrl={canonicalUrl} />

    <!-- Theme Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-6 sm:pt-8 pb-16 space-y-8">
        <!-- Hero Header -->
        <div class="text-center space-y-2 max-w-2xl mx-auto">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[var(--canvas-card)] border border-[#64748b]/30 text-[11px] font-mono text-[var(--ink-body)] shadow-2xs">
            <span class="h-1.5 w-1.5 rounded-full bg-[#64748b] animate-pulse"></span>
            Legal Terms & User Agreement
          </div>

          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--ink-primary)]">
            Terms & Conditions
          </h1>

          <p class="text-xs text-[var(--ink-mute)]">
            Last Updated: August 10, 2026
          </p>
        </div>

        <!-- Main Terms Document -->
        <article class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-xl p-4 sm:p-8 md:p-10 shadow-sm space-y-8 text-xs sm:text-sm text-[var(--ink-body)] leading-relaxed">
          
          <section class="space-y-3">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              1. Acceptance of Terms
            </h2>
            <p>
              By accessing and using <strong>AllAgeCalculators (allagecalculators.com)</strong>, you accept and agree to be bound by the terms and provision of this agreement. If you do not agree to abide by these terms, please do not use this site.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              2. Educational & Informational Purpose Only
            </h2>
            <p>
              The tools, calculators, age eligibility verdicts, attempt counters, and guidelines provided on AllAgeCalculators are for <strong>general informational and self-calculation purposes only</strong>.
            </p>
            <blockquote class="p-4 bg-[var(--canvas-inset)] border-l-4 border-[var(--ink-primary)] rounded-r-lg font-mono text-xs text-[var(--ink-primary)]">
              Official Disclaimer: This website is NOT affiliated with, endorsed by, or connected to the Union Public Service Commission (UPSC) or any government ministry. Candidates MUST cross-check their eligibility against official Gazette Notifications published at upsc.gov.in before filling out exam application forms.
            </blockquote>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              3. Permitted Use
            </h2>
            <p>
              You are granted a non-exclusive, non-transferable, revocable license to access and use AllAgeCalculators strictly in accordance with these terms. You agree not to use the website for any unlawful purpose or in any way that interrupts or damages website availability.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              4. Accuracy of Calculations & Disclaimer of Warranties
            </h2>
            <p>
              While we strive for 100% mathematical accuracy using official Rule 6 examination cutoff rules, standard leap year algorithms, and AVMA pet formulas, the content on AllAgeCalculators is provided "as is" without warranty of any kind, express or implied.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              5. Limitation of Liability
            </h2>
            <p>
              In no event shall AllAgeCalculators or its developers be liable for any direct, indirect, incidental, consequential, or punitive damages arising out of your access to, use of, or inability to use this website or any errors/omissions in calculation outputs.
            </p>
          </section>

          <section class="space-y-3 border-t border-[var(--hairline)] pt-6">
            <h2 class="text-lg font-bold tracking-tight text-[var(--ink-primary)]">
              6. Modifications to Terms
            </h2>
            <p>
              We reserve the right to revise and update these Terms & Conditions at any time without prior notice. By continuing to use the site after changes are posted, you accept those changes.
            </p>
          </section>

        </article>
      </main>
    </div>

    <Footer />
  </body>
</html>
