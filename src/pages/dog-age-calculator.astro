---
import Header from '../components/Header.astro';
import { DogAgeMode } from '../components/modes/DogAgeMode';
import SEOContent from '../components/SEOContent.astro';
import SEOSchema from '../components/SEOSchema.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const title = "Dog Age Calculator — Convert Dog Years to Human Years";
const description = "Free Dog Age Calculator on AllAgeCalculators. Convert dog age to human years using official AVMA breed size formulas. Includes sleep requirements and life stage care tips.";
const canonicalUrl = "https://allagecalculators.com/dog-age-calculator";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Dedicated Dog Age Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta 
      name="keywords" 
      content="dog age calculator, dog age, dog age calculator by breed, dog age in human years, pedigree dog age calculator, dog age calculator months, new dog age calculator, senior dog age, dog age to human age, dog age test, dog age 11" 
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AllAgeCalculators (allagecalculators.com)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://allagecalculators.com/og-image.png" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://allagecalculators.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="dog" title={title} description={description} canonicalUrl={canonicalUrl} />

    <!-- Theme Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-3 sm:pt-4 pb-12 space-y-4">
        <!-- Clean Hero Title -->
        <div class="text-center max-w-2xl mx-auto">
          <h1 class="text-lg sm:text-2xl font-bold tracking-tight text-[var(--ink-primary)]">
            Dog Age Calculator
          </h1>
        </div>

        <!-- Direct Dog Age Component -->
        <section id="dog-tool">
          <DogAgeMode client:load />
        </section>

        <!-- SEO Content & FAQ -->
        <SEOContent page="dog" />
      </main>
    </div>

    <Footer />
  </body>
</html>
