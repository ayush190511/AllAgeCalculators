---
import Header from '../components/Header.astro';
import { BabyAgeMode } from '../components/modes/BabyAgeMode';
import SEOContent from '../components/SEOContent.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Dedicated Baby Age Meta Tags -->
    <title>Baby Age Calculator — Calculate Age in Weeks, Months & Days</title>
    <meta name="title" content="Baby Age Calculator — Calculate Age in Weeks, Months & Days" />
    <meta 
      name="description" 
      content="Free Baby Age Calculator on AllAgeCalculators. Calculate exact baby age in weeks, months & days. Includes premature gestational corrected age adjustments and school admission milestone tracking." 
    />
    <meta 
      name="keywords" 
      content="baby age calculator, age calculator of baby, age calculator of child, calculate age in weeks and months, premature baby corrected age calculator, age calculator for school" 
    />
    <link rel="canonical" href="https://allagecalculators.com/baby-age-calculator" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://allagecalculators.com/baby-age-calculator" />
    <meta property="og:title" content="Baby Age Calculator — Calculate Age in Weeks, Months & Days" />
    <meta property="og:description" content="Calculate your baby's exact age in weeks, months, and total days. Includes pediatric corrected age adjustments for premature births." />

    <!-- Theme Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-16 space-y-10">
        <!-- Hero Title -->
        <div class="text-center space-y-3.5 max-w-3xl mx-auto pt-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[var(--canvas-card)] border border-[var(--hairline)] text-xs font-mono text-[var(--ink-body)] shadow-2xs">
            <span class="h-2 w-2 rounded-full bg-[#0070f3]"></span>
            Pediatric Milestone Standard
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink-primary)]">
            Baby Age Calculator
          </h1>

          <p class="text-sm sm:text-base text-[var(--ink-body)] leading-relaxed">
            Calculate your baby or child's exact age in <strong>Weeks, Months & Days</strong>. Includes optional <strong>gestational corrected age adjustment</strong> for premature births.
          </p>
        </div>

        <!-- Direct Baby Age Component -->
        <section id="baby-tool">
          <BabyAgeMode client:load />
        </section>

        <!-- SEO Content & FAQ -->
        <SEOContent />
      </main>
    </div>

    <Footer />
  </body>
</html>
