---
import Header from '../components/Header.astro';
import { BabyAgeMode } from '../components/modes/BabyAgeMode';
import SEOContent from '../components/SEOContent.astro';
import SEOSchema from '../components/SEOSchema.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const title = "Baby Age Calculator — Calculate Age in Weeks, Months & Days";
const description = "Free Baby Age Calculator on AllAgeCalculators. Calculate exact baby age in weeks, months & days. Includes premature gestational corrected age adjustments and school admission milestone tracking.";
const canonicalUrl = "https://allagecalculators.com/baby-age-calculator";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Dedicated Baby Age Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta 
      name="keywords" 
      content="baby age calculator, age calculator of baby, age calculator of child, calculate age in weeks and months, premature baby corrected age calculator, age calculator for school" 
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AllAgeCalculators (allagecalculators.com)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://allagecalculators.com/og-image.png" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://allagecalculators.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="baby" title={title} description={description} canonicalUrl={canonicalUrl} />

    <!-- Theme Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 pb-16 space-y-10">
        <!-- Hero Title -->
        <div class="text-center space-y-3.5 max-w-3xl mx-auto pt-4">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[var(--canvas-card)] border border-[#ec4899]/30 text-xs font-mono text-[var(--ink-body)] shadow-2xs">
            <span class="h-2 w-2 rounded-full bg-[#ec4899] animate-pulse"></span>
            Pediatric Milestone Standard
          </div>

          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--ink-primary)]">
            Baby Age Calculator
          </h1>

          <p class="text-sm sm:text-base text-[var(--ink-body)] leading-relaxed">
            Calculate your baby or child's exact age in <strong>Weeks, Months & Days</strong>. Includes optional <strong>gestational corrected age adjustment</strong> for premature births.
          </p>
        </div>

        <!-- Direct Baby Age Component -->
        <section id="baby-tool">
          <BabyAgeMode client:load />
        </section>

        <!-- SEO Content & FAQ -->
        <SEOContent page="baby" />
      </main>
    </div>

    <Footer />
  </body>
</html>
