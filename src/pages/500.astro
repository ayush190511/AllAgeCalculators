---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>500: Server Error — AllAgeCalculators</title>
    <meta name="description" content="An unexpected calculation error occurred. Return to AllAgeCalculators home." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="robots" content="noindex, follow" />

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--canvas)] text-[var(--ink-primary)] min-h-screen flex flex-col justify-between selection:bg-[#171717] selection:text-white transition-colors">
    <Header />

    <main class="flex-1 flex flex-col items-center justify-center px-4 py-12 sm:py-16">
      <!-- Main Card Container -->
      <div class="w-full max-w-md bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-2xl p-7 sm:p-9 shadow-2xs text-center overflow-hidden">
        
        <!-- Icon Badge -->
        <div class="inline-flex items-center justify-center w-14 h-14 rounded-2xl bg-[var(--canvas-inset)] border border-[var(--hairline)] text-amber-500 mb-5 shadow-2xs">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>

        <!-- 500 Hero Heading -->
        <span class="block text-xs font-mono font-bold tracking-widest text-amber-500 uppercase mb-1">Error 500</span>
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[var(--ink-primary)] mb-2">
          500: Server Error
        </h1>
        
        <p class="text-xs sm:text-sm text-[var(--ink-body)] mb-7 leading-relaxed max-w-sm mx-auto">
          An unexpected issue occurred while rendering the page. Don't worry, your date calculations are safe!
        </p>

        <!-- Single Primary Action Button -->
        <a 
          href="/" 
          class="w-full h-12 rounded-xl bg-[#0070f3] hover:bg-[#0761d1] text-white font-semibold text-sm shadow-sm transition-all duration-200 flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Return to Home Calculator
        </a>

      </div>
    </main>

    <Footer />
  </body>
</html>
