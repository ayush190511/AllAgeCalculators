---
import Header from '../components/Header.astro';
import { NormalAgeMode } from '../components/modes/NormalAgeMode';
import SEOContent from '../components/SEOContent.astro';
import SEOSchema from '../components/SEOSchema.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const title = "Online Age Calculator — Free Chronological Age Calculator by Date of Birth";
const description = "Free Online Age Calculator by date of birth. Calculate your exact chronological age in years, months, days & seconds today. Includes UPSC age calculator of India, retirement age calculator, dog age calculator, baby age calculator, and date gap tools.";
const canonicalUrl = "https://allagecalculators.com/";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta 
      name="keywords" 
      content="age calculator, chronological age calculator, age calculator by date of birth, age calculator of india, age calculator of child, age calculator of baby, dog age calculator, age calculator on today, age calculator of upsc, age calculator on date, online age calculator, free online age calculator, dog age, dog age calculator by breed, dog age in human years, pedigree dog age calculator, dog age calculator months, new dog age calculator, senior dog age, dog age to human age, dog age test, dog age 11, child age calculator, retirement age calculator, social security retirement age calculator, full retirement age calculator, child age, upsc age limit" 
    />
    <meta name="author" content="AllAgeCalculators" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="AllAgeCalculators (allagecalculators.com)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://allagecalculators.com/og-image.png" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://allagecalculators.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="home" title={title} description={description} canonicalUrl={canonicalUrl} />

    <!-- Theme Initialization Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-6 sm:pt-8 pb-16 space-y-6 sm:space-y-8">
        <!-- Focused Home Age Calculator Component -->
        <section id="calculator">
          <NormalAgeMode client:load />
        </section>

        <!-- SEO Below the Fold Content & Guide + FAQ Section -->
        <SEOContent page="home" />
      </main>
    </div>

    <Footer />
  </body>
</html>
